---
const testimonials = [
  {
    quote:
      "XMS AI completely transformed our lead generation. We saw a 300% increase in qualified leads within the first 90 days. The AI-powered approach is unlike anything we've seen before.",
    author: "John M.",
    role: "All Star Sunrooms",
    avatar: "https://i.pravatar.cc/150?img=11",
  },
  {
    quote:
      "Finally, an agency that understands the intersection of brand storytelling and AI automation. Our design inquiries doubled in just two months.",
    author: "Sarah T.",
    role: "Carson's Cabinetry & Design",
    avatar: "https://i.pravatar.cc/150?img=47",
  },
  {
    quote:
      "The autonomous ecosystem handles our entire content pipeline. It's like having a 50-person marketing team on autopilot — results speak for themselves.",
    author: "David K.",
    role: "Choice Epoxy Coatings",
    avatar: "https://i.pravatar.cc/150?img=32",
  },
  {
    quote:
      "Our client intake increased significantly. XMS AI built us a digital presence we're truly proud of. Professional, strategic, and results-driven.",
    author: "Carlos G.",
    role: "Garcia Sigmon Law Firm",
    avatar: "https://i.pravatar.cc/150?img=59",
  },
  {
    quote:
      "The level of customization is insane. It's not just generic AI — it's a tailor-made strategy for our specific market. Implementation was seamless.",
    author: "James W.",
    role: "Hault's",
    avatar: "https://i.pravatar.cc/150?img=68",
  },
  {
    quote:
      "The strategic clarity we gained was invaluable. They didn't just give us tools; they gave us a roadmap to dominate our local market.",
    author: "Michelle R.",
    role: "XMS AI Client",
    avatar: "https://i.pravatar.cc/150?img=15",
  },
];
---

<section
  class="py-24 md:py-32 bg-black relative overflow-hidden"
  id="testimonials"
>
  <!-- Galactic Nebula Background -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-blue-600/20 rounded-full blur-[120px] opacity-50"
    >
    </div>
    <div
      class="absolute top-1/4 left-1/4 w-[400px] h-[400px] bg-purple-600/10 rounded-full blur-[100px] opacity-30"
    >
    </div>
    <div
      class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-indigo-600/15 rounded-full blur-[100px] opacity-40"
    >
    </div>
  </div>
  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <span
        class="text-blue-400 text-sm font-mono tracking-widest uppercase mb-4 block"
        >RESULTS SPEAK LOUDER</span
      >
      <h2
        class="text-3xl md:text-5xl lg:text-6xl font-bold font-display text-white mb-6"
      >
        Trusted by Visionary Leaders
      </h2>
      <p class="text-white/60 text-lg max-w-2xl mx-auto">
        Powering hyper-growth for companies that refuse to settle for manual
        marketing.
      </p>
    </div>

    <div class="columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6">
      {
        testimonials.map((t) => (
          <div class="break-inside-avoid p-8 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md hover:bg-white/10 hover:border-white/20 transition-all duration-300 relative group text-center">
            <!-- Minimalist quote icon -->
            <div class="absolute top-4 right-6 text-2xl text-white/10 font-serif leading-none group-hover:text-blue-500/20 transition-colors">
              "
            </div>

            <p class="text-base text-white/80 font-condensed tracking-tighter mb-8 relative z-10 leading-relaxed group-hover:text-white transition-colors">
              "{t.quote}"
            </p>

            <div class="flex items-center justify-center gap-3 pt-4 border-t border-white/5">
              <img
                src={t.avatar}
                alt={t.author}
                width="32"
                height="32"
                loading="lazy"
                class="w-8 h-8 rounded-full border border-white/10 object-cover grayscale group-hover:grayscale-0 transition-all"
              />
              <div class="text-left">
                <div class="font-bold text-white font-display text-[12px] leading-tight">
                  {t.author}
                </div>
                <div class="text-[10px] text-white/40 tracking-wide">
                  {t.role}
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
