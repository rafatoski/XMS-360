---

<footer class="bg-black text-white py-16 border-t border-accent/20">
  <div class="container mx-auto px-4 max-w-7xl">
    <div
      class="flex flex-col md:flex-row justify-between items-start gap-12 mb-16"
    >
      <!-- Brand -->
      <div class="max-w-xs">
        <a href="https://xperienceaimarketing.com">
          <img
            src={`${
              import.meta.env.BASE_URL
            }brand/XMS LOGO - BLACK BACKGROUND.webp`}
            alt="XMS Ai Logo"
            class="h-10 w-auto mb-6"
          />
        </a>
        <p class="text-white/60 text-sm font-sans leading-relaxed">
          Intelligence-Driven Growth. <br /> Human-Guided Results.
        </p>
        <p class="text-white/50 text-xs mt-4 font-mono">
          XMS Ai enhances brand performance by merging intelligent automation
          with strategic content optimization.
        </p>

        <!-- Social Icons -->
        <div class="flex items-center gap-3 mt-6">
          {
            socialLinks.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.name}
                title={s.name}
                class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white/50 hover:text-white hover:bg-white/10 hover:border-white/30 transition-all duration-200"
              >
                <Fragment set:html={s.icon} />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Links -->
      <div
        class="grid grid-cols-2 lg:grid-cols-4 gap-8 md:gap-16 w-full md:w-auto"
      >
        <div>
          <h4 class="font-display font-bold text-white mb-4">Company</h4>
          <ul class="space-y-2 text-sm text-white/50 font-sans">
            <li>
              <a
                href="https://xperienceaimarketing.com/about-us-xms-ai-marketing-team/"
                class="hover:text-accent hover:underline underline-offset-2 transition-colors">About Us</a
              >
            </li>
            <li>
              <a
                href="https://xperienceaimarketing.com/360-ecosystem"
                class="hover:text-accent hover:underline underline-offset-2 transition-colors"
                >Ai Marketing Solutions</a
              >
            </li>
            <li>
              <a
                href="https://xperienceaimarketing.com/contact-us/"
                class="hover:text-accent hover:underline underline-offset-2 transition-colors">Contact</a
              >
            </li>
          </ul>
        </div>
        <div>
          <h4 class="font-display font-bold text-white mb-4">Services</h4>
          <ul class="space-y-2 text-sm text-white/50 font-sans">
            <li>
              <a
                href="https://xperienceaimarketing.com/website-development/"
                class="hover:text-accent hover:underline underline-offset-2 transition-colors">Ai Websites</a
              >
            </li>
            <li>
              <a
                href="https://xperienceaimarketing.com/creative-content-and-design/"
                class="hover:text-accent hover:underline underline-offset-2 transition-colors">Creative Content</a
              >
            </li>
            <li>
              <a
                href="https://xperienceaimarketing.com/360-ecosystem"
                class="hover:text-accent hover:underline underline-offset-2 transition-colors">360° Ecosystem</a
              >
            </li>
          </ul>
        </div>
        <div>
          <h4 class="font-display font-bold text-white mb-4">Legal</h4>
          <ul class="space-y-2 text-sm text-white/50 font-sans">
            <li>
              <a href={`${import.meta.env.BASE_URL}privacy`} class="hover:text-accent hover:underline underline-offset-2 transition-colors">Privacy</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}terms`} class="hover:text-accent hover:underline underline-offset-2 transition-colors">Terms</a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom -->
    <div
      class="pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-white/50 font-mono"
    >
      <div>
        &copy; {currentYear} XMS Ai Marketing. All Rights Reserved.
      </div>
      <div class="flex gap-4">
        <span>Port Saint Lucie, FL</span>
      </div>
    </div>
  </div>
</footer>
