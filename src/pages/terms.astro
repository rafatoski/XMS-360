---
import "../styles/global.css";
import Header from "../components/Header";
import Footer from "../components/Footer.astro";

const siteUrl = "https://xperienceaimarketing.com";
const pageTitle = "Terms of Service | XMS Ai";
const pageDescription = "Read the Terms of Service for XMS Ai. These terms govern your use of our website and AI-powered marketing services.";
const lastUpdated = "March 2, 2026";
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${siteUrl}/360-ecosystem/terms`} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}/360-ecosystem/terms`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <script defer data-domain="xperienceaimarketing.com" src="https://plausible.io/js/script.js"></script>
  </head>
  <body class="bg-black text-white antialiased overflow-x-hidden">
    <Header client:load />

    <main class="pt-32 pb-24">
      <div class="container mx-auto px-4 max-w-3xl">

        {/* Header */}
        <div class="mb-12">
          <p class="text-blue-400 font-mono text-xs tracking-widest uppercase mb-4">Legal</p>
          <h1 class="text-4xl md:text-5xl font-bold font-display text-white mb-4">Terms of Service</h1>
          <p class="text-white/40 font-mono text-sm">Last updated: {lastUpdated}</p>
        </div>

        <div class="prose-legal">

          <section class="mb-10">
            <h2>1. Agreement to Terms</h2>
            <p>
              By accessing or using the website at <a href={siteUrl}>{siteUrl}</a> or any of its subpages (collectively, the "Site"), you agree to be bound by these Terms of Service ("Terms"). These Terms apply to all visitors, users, and clients of XMS Ai, operated by Xperience Marketing Solutions, LLC ("Company," "we," "us," or "our"), based in Port Saint Lucie, Florida, USA.
            </p>
            <p>If you do not agree to these Terms, please do not use our Site or services.</p>
          </section>

          <section class="mb-10">
            <h2>2. Services Description</h2>
            <p>
              XMS Ai provides AI-powered marketing services including, but not limited to: Answer Engine Optimization (AEO), search engine optimization (SEO), paid media management, content marketing, marketing automation, AI website development, and strategic consulting.
            </p>
            <p>
              Specific service terms, deliverables, timelines, and fees are defined in individual client service agreements or proposals, which supplement these Terms.
            </p>
          </section>

          <section class="mb-10">
            <h2>3. Use of the Site</h2>
            <p>You agree to use this Site only for lawful purposes. You must not:</p>
            <ul>
              <li>Use the Site in any way that violates applicable local, national, or international laws or regulations</li>
              <li>Attempt to gain unauthorized access to any part of the Site or its related systems</li>
              <li>Transmit any unsolicited or unauthorized advertising or promotional material</li>
              <li>Reproduce, duplicate, or resell any part of our Site without express written permission</li>
              <li>Use automated tools to scrape, crawl, or extract data from the Site without permission</li>
            </ul>
          </section>

          <section class="mb-10">
            <h2>4. Intellectual Property</h2>
            <p>
              All content on this Site — including text, graphics, logos, images, and software — is the property of XMS Ai or its content suppliers and is protected by applicable intellectual property laws.
            </p>
            <p>
              You may not reproduce, distribute, modify, or create derivative works from any content on this Site without our prior written consent. Limited use for personal, non-commercial reference is permitted.
            </p>
          </section>

          <section class="mb-10">
            <h2>5. Free AI Growth Audit</h2>
            <p>
              The free AI Growth Audit offered on this Site is a complimentary analysis provided at our discretion. Submitting an audit request does not create a contractual obligation on either party. Results are provided for informational purposes and do not constitute professional advice. Turnaround times are estimates and not guaranteed.
            </p>
          </section>

          <section class="mb-10">
            <h2>6. Disclaimer of Warranties</h2>
            <p>
              The Site and its content are provided on an "as is" and "as available" basis without warranties of any kind, either express or implied. We do not warrant that the Site will be uninterrupted, error-free, or free of viruses or other harmful components.
            </p>
            <p>
              Marketing results vary based on numerous factors including market conditions, competition, and client-side execution. We make no guarantees of specific outcomes from our services.
            </p>
          </section>

          <section class="mb-10">
            <h2>7. Limitation of Liability</h2>
            <p>
              To the fullest extent permitted by law, XMS Ai and its officers, directors, employees, and agents shall not be liable for any indirect, incidental, special, consequential, or punitive damages arising from your use of the Site or our services — even if we have been advised of the possibility of such damages.
            </p>
            <p>
              Our total liability to you for any claim arising from these Terms or your use of our services shall not exceed the amount paid by you to us in the 3 months preceding the claim.
            </p>
          </section>

          <section class="mb-10">
            <h2>8. Third-Party Links</h2>
            <p>
              This Site may contain links to third-party websites. These links are provided for your convenience only. We have no control over the content of those sites and accept no responsibility for them or for any loss or damage that may arise from your use of them.
            </p>
          </section>

          <section class="mb-10">
            <h2>9. Governing Law</h2>
            <p>
              These Terms shall be governed by and construed in accordance with the laws of the State of Florida, USA, without regard to its conflict of law provisions. Any disputes arising under these Terms shall be subject to the exclusive jurisdiction of the courts located in St. Lucie County, Florida.
            </p>
          </section>

          <section class="mb-10">
            <h2>10. Changes to These Terms</h2>
            <p>
              We reserve the right to modify these Terms at any time. Changes will be effective immediately upon posting to the Site. The "Last updated" date at the top of this page reflects the most recent revision. Your continued use of the Site after any changes constitutes your acceptance of the new Terms.
            </p>
          </section>

          <section class="mb-10">
            <h2>11. Contact Us</h2>
            <p>If you have questions about these Terms of Service, please contact us:</p>
            <ul>
              <li><strong>Email:</strong> <a href="mailto:legal@xperienceaimarketing.com">legal@xperienceaimarketing.com</a></li>
              <li><strong>Address:</strong> Port Saint Lucie, FL, USA</li>
              <li><strong>Website:</strong> <a href={`${siteUrl}/contact-us/`}>{siteUrl}/contact-us/</a></li>
            </ul>
          </section>

        </div>

        {/* Back link */}
        <div class="mt-16 pt-8 border-t border-white/10">
          <a href={import.meta.env.BASE_URL} class="text-blue-400 hover:text-blue-300 font-mono text-sm transition-colors">
            ← Back to XMS Ai
          </a>
        </div>

      </div>
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  .prose-legal h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
    margin-bottom: 0.75rem;
    margin-top: 0;
  }
  .prose-legal h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: rgba(255,255,255,0.8);
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }
  .prose-legal p {
    color: rgba(255,255,255,0.6);
    font-family: var(--font-sans);
    line-height: 1.75;
    margin-bottom: 0.75rem;
  }
  .prose-legal ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .prose-legal ul li {
    color: rgba(255,255,255,0.6);
    font-family: var(--font-sans);
    line-height: 1.75;
    margin-bottom: 0.25rem;
  }
  .prose-legal a {
    color: #60a5fa;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }
  .prose-legal a:hover {
    color: #93c5fd;
  }
  .prose-legal strong {
    color: rgba(255,255,255,0.9);
    font-weight: 600;
  }
</style>
