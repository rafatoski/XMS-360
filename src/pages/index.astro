---
import "../styles/global.css";
import Header from "../components/Header";
import GlassHero from "../components/GlassHero";
import VideoSection from "../components/VideoSection.astro";
import PainPoints from "../components/PainPoints.astro";
import ModernTools from "../components/ModernTools";
import Industries from "../components/Industries.astro";
import Testimonials from "../components/Testimonials.astro";
import FAQ from "../components/FAQ";
import ContactForm from "../components/ContactForm";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";

const siteUrl = "https://xperienceaimarketing.com";
const pageTitle = "XMS Ai | Ai-Powered 360° Marketing Ecosystem";
const pageDescription =
  "Scale your brand with XMS Ai. We combine 20+ years of marketing expertise with enterprise-grade Ai tools to create a unified 360° growth ecosystem.";
const ogImage = `${siteUrl}/og-image.png`;
const lastModified = new Date().toISOString().split("T")[0];

const jsonLdOrganization = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${siteUrl}/#organization`,
  name: "XMS Ai",
  alternateName: "Xperience Marketing Solutions",
  url: siteUrl,
  logo: `${siteUrl}/brand/XMS LOGO - BLACK BACKGROUND.webp`,
  image: ogImage,
  description:
    "XMS Ai is an AI-powered 360° marketing ecosystem that combines 20+ years of expertise with enterprise-grade automation to diagnose, architect, deploy, and optimize brand growth.",
  foundingDate: "2004",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Port Saint Lucie",
    addressRegion: "FL",
    addressCountry: "US",
  },
  areaServed: "US",
  serviceType: [
    "AI Marketing",
    "Answer Engine Optimization",
    "SEO",
    "Content Marketing",
    "Paid Media",
    "Marketing Automation",
  ],
  sameAs: [
    "https://www.tiktok.com/@xms_florida",
    "https://www.instagram.com/xperiencemarketingsolutions/",
    "https://www.youtube.com/user/xperiencemarketingso",
    "https://x.com/XMS_Marketing",
    "https://www.facebook.com/XperienceMarketingSolutions",
    "https://www.linkedin.com/company/xperience-marketing-solutions",
  ],
};

const jsonLdWebSite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  url: siteUrl,
  name: "XMS Ai",
  description: pageDescription,
  publisher: { "@id": `${siteUrl}/#organization` },
  potentialAction: {
    "@type": "SearchAction",
    target: { "@type": "EntryPoint", urlTemplate: `${siteUrl}/?s={search_term_string}` },
    "query-input": "required name=search_term_string",
  },
};

const jsonLdFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How is XMS different from a traditional agency?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "XMS Ai is a hybrid Ai + Human ecosystem. Traditional agencies rely on manual labor and billable hours. XMS relies on intelligent automation and performance outcomes, building clients a proprietary growth engine rather than just executing tasks.",
      },
    },
    {
      "@type": "Question",
      name: "What is AEO and why does it matter?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "AEO (Answer Engine Optimization) is the future of SEO. As users shift to AI search tools like ChatGPT, Perplexity, and Gemini, ranking for keywords is no longer enough. Brands must become the referenced authority cited by AI models.",
      },
    },
    {
      "@type": "Question",
      name: "Do I need to replace my current marketing team?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. XMS Ai is an ecosystem accelerator. It partners with internal marketing teams to supercharge their capabilities with AI tools and high-level strategy, allowing them to focus on creative work and execution.",
      },
    },
    {
      "@type": "Question",
      name: "How fast can we see results with XMS Ai?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The Diagnose and Architect phases typically take 2–3 weeks. Deployment begins immediately after. Most clients see significant efficiency gains within 30 days and measurable revenue impact within 60–90 days.",
      },
    },
    {
      "@type": "Question",
      name: "Is XMS Ai suitable for B2B or B2C businesses?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Both. The XMS Ecosystem principles of Authority, Automation, and Analytics are universal. The specific channels and messaging are tailored to each business model, whether high-ticket B2B sales or high-volume B2C acquisition.",
      },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/png"
      href={`${import.meta.env.BASE_URL}favicon.png`}
    />
    <link
      rel="apple-touch-icon"
      href={`${import.meta.env.BASE_URL}apple-touch-icon.png`}
    />
    <meta name="generator" content={Astro.generator} />

    {/* Primary Meta Tags */}
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content="AI marketing agency, answer engine optimization, AEO, AI-powered marketing, 360 marketing ecosystem, marketing automation, SEO, content marketing, Port Saint Lucie FL, XMS Ai" />
    <meta name="author" content="XMS Ai" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="last-modified" content={lastModified} />
    <link rel="canonical" href={siteUrl} />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />

    {/* Twitter */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={pageDescription} />
    <meta property="twitter:image" content={ogImage} />

    {/* Preconnect to Google Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    {/* JSON-LD Structured Data — AEO */}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdOrganization)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebSite)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFAQ)} />

    {/* Plausible Analytics */}
    <script
      defer
      data-domain="xperienceaimarketing.com"
      src="https://plausible.io/js/script.js"
    ></script>
  </head>
  <body
    class="bg-black text-white antialiased selection:bg-accent selection:text-black overflow-x-hidden"
  >
    <Header client:load />

    <main>
      <GlassHero client:load />
      <VideoSection />
      <PainPoints />

      <div id="tools">
        <ModernTools client:visible />
      </div>
      <Industries />
      <Testimonials />
      <FAQ client:visible />
      <ContactForm client:visible />
      <CTA />
    </main>

    <Footer />

    <div class="el-siri-glow" aria-hidden="true"></div>
    <elevenlabs-convai agent-id="agent_9901kjdgmj5sfmqrh85sk3dpvy80"></elevenlabs-convai>

    <style is:global>
      @keyframes siri-gradient {
        0%, 100% { background-position: 0% 50%; }
        50%       { background-position: 100% 50%; }
      }
      @keyframes siri-pulse {
        0%, 100% { opacity: 0.55; }
        50%       { opacity: 0.9; }
      }
      .el-siri-glow {
        position: fixed;
        bottom: 16px;
        right: 16px;
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: linear-gradient(135deg, #9333ea, #3b82f6, #06b6d4, #9333ea);
        background-size: 300% 300%;
        animation: siri-gradient 4s ease infinite, siri-pulse 4s ease infinite;
        filter: blur(14px);
        z-index: 999;
        pointer-events: none;
        will-change: transform, opacity;
      }
    </style>

    <script is:inline>
      (function () {
        const host = document.querySelector("elevenlabs-convai");
        if (!host) return;

        function collapse() {
          const sr = host.shadowRoot;
          if (!sr) return false;
          if (sr.querySelector('[aria-label="Open chat"]')) return true;
          const btn =
            sr.querySelector('[aria-label="Close chat"]') ??
            sr.querySelector('[aria-label*="Close"]') ??
            sr.querySelector('[aria-label*="close"]');
          if (btn) { btn.click(); return true; }
          return false;
        }

        function watchShadowRoot() {
          const sr = host.shadowRoot;
          if (!sr) return;
          if (collapse()) return;
          const obs = new MutationObserver(() => {
            if (collapse()) obs.disconnect();
          });
          obs.observe(sr, { childList: true, subtree: true, attributes: true });
        }

        customElements.whenDefined("elevenlabs-convai").then(() => {
          customElements.upgrade(host);
          watchShadowRoot();
        });

        if (customElements.get("elevenlabs-convai")) watchShadowRoot();
      })();
    </script>

    <script defer src="https://unpkg.com/@elevenlabs/convai-widget-embed"></script>
  </body>
</html>
